    procedure CalculaCUIT(): Integer
    var
        Clave: Text[13];
        Longitud: Integer;
        i: Integer;
        NClave: array[10] of Text[13];
        j: Integer;
        ClaveFinal: array[10] of Text[13];
        cont: Integer;
        NNumero: Integer;
        Subtotal: array[10] of Integer;
        Total: Integer;
        Resto: Integer;
        CUIT: Integer;
    begin
        Clave := "VAT Registration No.";
        Longitud := StrLen(Clave);

        repeat
            i := i + 1;
            NClave[i] := CopyStr(Clave, i, 1);
            if NClave[i] in ['0' .. '9'] then begin
                j := j + 1;
                ClaveFinal[j] := NClave[i];
            end;

        until i = Longitud;

        Longitud := j;
        i := Longitud;
        j := 2;
        repeat
            cont := cont + 1;
            Evaluate(NNumero, ClaveFinal[i]);

            if cont <= 6 then begin
                Subtotal[i] := NNumero * j;
                j := j + 1;
            end else begin
                j := 2;
                Subtotal[i] := NNumero * j;
                cont := 1;
                j := j + 1;
            end;
            Total := Total + Subtotal[i];
            i := i - 1;
        until i = 0;


        Resto := Total mod 11;
        if Resto = 0 then
            CUIT := 0
        else
            if Resto = 1 then
                Error('El número es incompatible')
            else
                CUIT := 11 - Resto;

        exit(CUIT);
    end;

    local procedure fntActualizarSeptima()
    var
        l_rstGLS: Record "General Ledger Setup";
        l_rstD: Record Dimension;
        l_rstDV: Record "Dimension Value";
        l_rst352: Record "Default Dimension";
    begin
        //++Arbu 2020
        //Cambiar el nombre de la dimensión global 7 a Relación Costo
        Clear(l_rstGLS);
        l_rstGLS.Get();
        if l_rstGLS."Global Dimension 7 Code" <> '' then begin

            Clear(l_rstD);
            l_rstD.SetRange(Code, l_rstGLS."Global Dimension 7 Code");
            if l_rstD.FindFirst then begin

                Clear(l_rstDV);
                l_rstDV."Dimension Code" := l_rstD.Code;
                l_rstDV.Code := "No.";
                l_rstDV.Name := CopyStr(Name, 1, 50);
                l_rstDV."Dimension Value Type" := l_rstDV."Dimension Value Type"::Standard;
                l_rstDV."Global Dimension No." := 7;
                if not l_rstDV.Insert(true) then;

                Clear(l_rst352);
                l_rst352."Table ID" := 23;
                l_rst352."No." := l_rstDV.Code;
                l_rst352."Dimension Code" := l_rstDV."Dimension Code";
                l_rst352."Dimension Value Code" := l_rstDV.Code;
                l_rst352."Value Posting" := l_rst352."Value Posting"::"Code Mandatory";
                if not l_rst352.Insert(true) then;

            end;

        end;

        //--Arbu 2020
    end;

