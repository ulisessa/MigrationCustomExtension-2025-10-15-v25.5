        field(50510; "Fecha vencimiento CAI"; Date)
        {

            trigger OnValidate()
            begin
                Clear(rstConfCompras);
                rstConfCompras.Get();
                if ("Vendor Posting Group" = rstConfCompras."Grupo Contable Importaciones") and
                   ("No." = rstConfCompras."Proveedor Aduana Exterior") then
                    Error('No se debe ingresar fecha de vencimiento de CAI para proveedores del exterior');

                if "Fecha vencimiento CAI" > CalcDate('36M', Today) then
                    Error('La fecha de vencimiento de CAI ingresada es incorrecta.');

                if not "Lleva CAI" then
                    Error('Debe marcar la opción "Lleva CAI"');
            end;
        }
