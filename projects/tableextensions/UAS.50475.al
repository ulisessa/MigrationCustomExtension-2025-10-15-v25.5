    procedure fntSerialNo()
    var
        vconfventas: Record "Sales & Receivables Setup";
        vcliente: Record Customer;
        vseriefacturas: Record "Invoice no. setup";
        LETRA: Code[1];
    begin
        vconfventas.Get();
        vcliente.Get("Sell-to Customer No.");

        if ("Document Type" = "Document Type"::Order) then begin

            "Shipping No. Series" := vconfventas."Posted Shipment Nos.";
            vseriefacturas.Reset;
            vseriefacturas.SetRange(vseriefacturas."Actividad comercial", vcliente."Punto de Venta");
            vseriefacturas.SetRange(vseriefacturas."Tipo impuesto", vcliente."Tipo Fiscal");
            vseriefacturas.SetRange(vseriefacturas."Tipo factura", vseriefacturas."Tipo factura"::Remito);

            if vseriefacturas.Find('-') then begin
                "Shipping No. Series" := vseriefacturas."No. serie";
            end
            else
                Error('debe configurar No. de serie para: \' +
                       'Actividad comercial: %1 \' +
                       'Tipo factura: %2\' +
                       'Tipo Fiscal: %3', vcliente."Punto de Venta", 'Remito', vcliente."Tipo Fiscal");

        end;

        if ("Document Type" = "Document Type"::Invoice) or ("Document Type" = "Document Type"::Order) then begin

            vseriefacturas.Reset;
            vseriefacturas.SetRange(vseriefacturas."Tipo impuesto", vcliente."Tipo Fiscal");
            vseriefacturas.SetRange(vseriefacturas."Actividad comercial", vcliente."Punto de Venta");
            vseriefacturas.SetRange(vseriefacturas."Tipo factura", vseriefacturas."Tipo factura"::Factura);
            if vseriefacturas.Find('-') then begin

                "Posting No. Series" := vseriefacturas."No. serie";
                LETRA := vseriefacturas.Letra;

            end
            else
                Error('debe configurar No. de serie para: \' +
                       'Tipo Fiscal: %1 \' +
                       'Actividad comercial: %2 \' +
                       'Tipo factura: %3', vcliente."Tipo Fiscal", vcliente."Punto de Venta", 'Factura');

        end;

        /*IF ("Document type" = "Document type"::"Invoice") THEN
        BEGIN
        
          vseriefacturas.RESET;
          vseriefacturas.SETRANGE(vseriefacturas."Tipo impuesto",vcliente."Tipo Fiscal");
          vseriefacturas.SETRANGE(vseriefacturas."Actividad comercial",vcliente."Punto de Venta");
          vseriefacturas.SETRANGE(vseriefacturas."Tipo factura",vseriefacturas."Tipo factura"::"Nota Débito");
          IF vseriefacturas.FIND('-') THEN
          BEGIN
        
            "No. serie registro" := vseriefacturas."No. serie";
            LETRA := vseriefacturas.Letra;
            confventas.GET();
            "No. serie alb. venta" := confventas."No. serie alb. venta registrado";
        
          END
          ELSE
          ERROR ('debe configurar No. de serie para: \'+
                 'Tipo impuesto : %1 \'+
                 'Actividad comercial: %2 \'+
                 'Tipo factura: %3',vcliente."Tipo Fiscal", vcliente."Punto de Venta",'Nota Débito');
        
        END;
        */

        if ("Document Type" = "Document Type"::"Credit Memo") or ("Document Type" = "Document Type"::"Return Order") then begin

            vcliente.Get("Sell-to Customer No.");
            vseriefacturas.Reset;
            vseriefacturas.SetRange(vseriefacturas."Tipo impuesto", vcliente."Tipo Fiscal");
            vseriefacturas.SetRange(vseriefacturas."Actividad comercial", vcliente."Punto de Venta");
            vseriefacturas.SetRange(vseriefacturas."Tipo factura", vseriefacturas."Tipo factura"::"Nota Crédito");
            if vseriefacturas.Find('-') then begin

                "Posting No. Series" := vseriefacturas."No. serie";
                LETRA := vseriefacturas.Letra;

            end
            else
                Error('debe configurar No. de serie para: \' +
                       'Tipo impuesto : %1 \' +
                       'Actividad comercial: %2 \' +
                       'Tipo factura: %3', vcliente."Tipo Fiscal", vcliente."Punto de Venta", 'Nota Crédito');

        end;

        CalcFields("Tipo documento mensajeria");
        if "Tipo documento mensajeria" = 'Nota Crédito interna (ventas)' then begin

            "Posting No." := "No.";
            "Posting No. Series" := '';

        end;

        Modify;

    end;

    procedure fntFormatVendDoc(var codDoc: Code[20])
    var
        pasa: Boolean;
        primeraparte: Code[50];
        segundaparte: Code[50];
        terceraparte: Code[50];
        posicion: Integer;
        resto: Code[50];
        parte2: Integer;
        parte3: Integer;
        MovProv: Record "Cust. Ledger Entry";
        rstHFactura: Record "Sales Invoice Header";
        rstCabCompra: Record "Sales Header";
        rstHNC: Record "Sales Cr.Memo Header";
        rstConfCompras: Record "Purchases & Payables Setup";
        rstProveedor: Record Vendor;
    begin
        //US.ARBU - 20050407 - Inicio - Si el proveedor es nacional, que verifique el formato del No. de factura

        Clear(rstConfCompras);
        Clear(rstProveedor);

        rstConfCompras.Get();
        //rstProveedor.GET("Buy-from Vendor No.");

        pasa := false;
        posicion := StrPos(codDoc, '-');
        if posicion = 0 then
            if Confirm('Factura no corresponde al formato LNNNNN-NNNNNNNN.\ Desea continuar?') then
                pasa := true
            else
                Error('Operación cancelada');

        if not pasa then begin

            primeraparte := CopyStr(codDoc, 1, 1);
            resto := CopyStr(codDoc, 2, StrLen(codDoc));
            segundaparte := CopyStr(resto, 1, (posicion - 2));
            resto := CopyStr(resto, (posicion), (StrLen(resto)));
            terceraparte := resto;

        end;

        // Comprobamos que el primer caracter es una letra
        if (primeraparte < 'A') or (primeraparte > 'Z') then begin
            if not pasa then
                if Confirm('Factura no corresponde al formato LNNNNN-NNNNNNNN.\ Desea continuar?') then
                    pasa := true
                else
                    Error('Operación cancelada');
        end;

        // Comprobamos que los cuatro siguiente caracteres son numéricos y rellenamos con 0 hasta el cuarto
        if not (Evaluate(parte2, segundaparte)) then begin
            if not pasa then
                if Confirm('Factura no corresponde al formato LNNNNN-NNNNNNNN.\ Desea continuar?') then
                    pasa := true
                else
                    Error('Operación cancelada');
        end
        else begin
            if not pasa then
                case
                  StrLen(segundaparte) of
                    1:
                        segundaparte := '0000' + segundaparte;
                    2:
                        segundaparte := '000' + segundaparte;
                    3:
                        segundaparte := '00' + segundaparte;
                    4:
                        segundaparte := '0' + segundaparte;
                end;
        end;

        // Comprobamos que los 8 siguientes caracteres al - son numéricos y rellenamos con 0 hasta el octavo
        if not (Evaluate(parte3, terceraparte)) then begin
            if not pasa then
                if Confirm('Factura no corresponde al formato LNNNNN-NNNNNNNN.\ Desea continuar?') then
                    pasa := true
                else
                    Error('Operación cancelada');
        end
        else begin
            if StrLen(terceraparte) = 1 then
                terceraparte := '0000000' + terceraparte
            else
                if StrLen(terceraparte) = 2 then
                    terceraparte := '000000' + terceraparte
                else
                    if StrLen(terceraparte) = 3 then
                        terceraparte := '00000' + terceraparte
                    else
                        if StrLen(terceraparte) = 4 then
                            terceraparte := '0000' + terceraparte
                        else
                            if StrLen(terceraparte) = 5 then
                                terceraparte := '000' + terceraparte
                            else
                                if StrLen(terceraparte) = 6 then
                                    terceraparte := '00' + terceraparte
                                else
                                    if StrLen(terceraparte) = 7 then
                                        terceraparte := '0' + terceraparte
        end;
        // formamos el campo con todas las partes

        if not pasa then
            codDoc := primeraparte + segundaparte + '-' + terceraparte;

        if (codDoc <> '') and ("Document Type" = "Document Type"::Invoice) then begin

            Clear(MovProv);
            MovProv.SetCurrentKey(MovProv."Customer No.", MovProv."External Document No.");
            MovProv.SetRange(MovProv."Document Type", MovProv."Document Type"::Invoice);
            MovProv.SetRange(MovProv."Customer No.", "Sell-to Customer No.");
            MovProv.SetRange(MovProv."External Document No.", codDoc);
            if MovProv.Find('-') then begin

                Clear(rstHFactura);
                rstHFactura.Get(MovProv."Document No.");
                rstHFactura.CalcFields("Tipo documento mensajeria");
                if rstHFactura."Tipo documento mensajeria" <> 'Nota Débito (compras)' then
                    Error('Ya existe la factura %1 para el cliente %2', MovProv."External Document No.", "Sell-to Customer No.");

            end;

            Clear(rstCabCompra);
            rstCabCompra.SetRange(rstCabCompra."Document Type", rstCabCompra."Document Type"::Invoice);
            rstCabCompra.SetRange(rstCabCompra."Sell-to Customer No.", "Sell-to Customer No.");
            rstCabCompra.SetRange(rstCabCompra."External Document No.", codDoc);
            rstCabCompra.SetFilter("No.", '<>%1', "No.");
            if rstCabCompra.Find('-') then
                Error('Ya existe la factura %1 para el cliente %2', codDoc, rstCabCompra."Sell-to Customer No.");

            //US.ARBU - 2005-06-17 - Fin - Verifico que no exista una factura con el mismo número para ?ste proveedor

            //US.ARBU - 2005-06-09 - Inicio - Si el usuario ingresa el No. de factura del proveedor, tambión lo inserta en el No. de remito

        end;

        if (codDoc <> '') and ("Document Type" = "Document Type"::"Credit Memo") then begin

            Clear(MovProv);
            MovProv.SetCurrentKey(MovProv."Customer No.", MovProv."External Document No.");
            MovProv.SetRange(MovProv."Document Type", MovProv."Document Type"::"Credit Memo");
            MovProv.SetRange(MovProv."Customer No.", "Sell-to Customer No.");
            MovProv.SetRange(MovProv."External Document No.", codDoc);
            if MovProv.Find('-') then
                Error('Ya existe la NC %1 para el cliente %2', MovProv."External Document No.", "Sell-to Customer No.");
            /*
CLEAR(rstCabCompra);
rstCabCompra.SETRANGE(rstCabCompra."Document Type",rstCabCompra."Document Type"::"Credit Memo");
rstCabCompra.SETRANGE(rstCabCompra."Sell-to Customer No.","Sell-to Customer No.");
rstCabCompra.SETRANGE(rstCabCompra."External Document No.","Vendor Cr. Memo No.");
IF rstCabCompra.FIND('-') THEN
ERROR('Ya existe la NC %1 para el proveedor %2',rstCabCompra."Vendor Cr. Memo No.",rstCabCompra."Buy-from Vendor No.");
*/
            //US.ARBU - 2005-06-17 - Fin - Verifico que no exista una factura con el mismo número para ?ste proveedor

            //US.ARBU - 2005-06-09 - Inicio - Si el usuario ingresa el No. de factura del proveedor, tambión lo inserta en el No. de remito

        end;


        //US.ARBU - 2005-06-09 - Fin - Si el usuario ingresa el No. de factura del proveedor, tambión lo inserta en el No. de remito

    end;

